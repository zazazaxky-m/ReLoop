// Prisma schema for ReLoop - Smart Waste Bank Pangandaran
// Prisma 6.x (stable) + PostgreSQL.
//
// Ledger policy: RewardLedger is APPEND-ONLY. Rows are never deleted and
// amount/entryType/references are never edited after creation. The only mutable
// field is `status` (settlement lifecycle: PENDING -> AVAILABLE / REDEEMED / REJECTED).
// Monetary corrections are always NEW entries (REVERSE / ADJUST). Amounts are signed
// integers in rupiah (credits positive, debits negative); balance = SUM(amount).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum Role {
  SUPERADMIN
  ADMIN
  PENGEPUL
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrgType {
  SCHOOL
  CAMPUS
  VILLAGE
  TOURISM_SITE
  OFFICE
  COMMUNITY
  WASTE_BANK
  OTHER
}

enum OrgStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PartnerStatus {
  INVITED
  REQUESTED
  PENDING_SUPERADMIN_APPROVAL
  ACTIVE
  SUSPENDED
  REMOVED
  REJECTED
}

enum RegionType {
  PROVINCE
  REGENCY
  DISTRICT
  VILLAGE
}

enum MachineStatus {
  ONLINE
  OFFLINE
  FULL
  MAINTENANCE
  ERROR
}

enum WasteUnit {
  ITEM
  KG
}

enum CampaignType {
  MACHINE_DEPOSIT
  TRASH_BAG
  EVENT
  SCHOOL_PROGRAM
  TOURISM_PROGRAM
}

enum CampaignVisibility {
  PUBLIC
  PRIVATE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum CampaignRewardMode {
  MONEY_REWARD
  COMPLIANCE_ONLY
}

/// How a machine verifies that an inserted item is the selected waste type
/// (lib/reward-policy.ts verifyMaterial). A label the classifier did report is
/// always checked against WasteType.aiAcceptedLabels, whatever the policy.
enum MaterialVerification {
  /// The classifier must confirm the item; missing/unavailable AI holds it for review.
  AI_REQUIRED
  /// No AI dependency: a barcode must be read and the weight must be in range.
  BARCODE_WEIGHT
  /// Weight window only (behaviour before M04; default).
  WEIGHT_ONLY
}

/// RewardReconciliationCase lifecycle: OPEN until an operator settles it outside the ledger flow.
enum RewardReconciliationStatus {
  OPEN
  RESOLVED
}

/// B01: cash-side movements of a RewardFundingAccount (immutable rows).
enum FundingEntryKind {
  CONFIRMED_TOPUP
  PAYOUT
  CORRECTION
}

/// B01: what a reward budget reservation was taken for.
enum RewardReservationSource {
  SESSION
  TRIP
}

enum RewardReservationStatus {
  ACTIVE
  RELEASED
}

enum SessionStatus {
  RESERVED
  ACTIVE
  PROCESSING_ITEM
  COMPLETED
  REVIEW
  CANCELLED
  EXPIRED
}

enum DepositItemStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVIEW
}

enum ItemSource {
  MACHINE
  MANUAL
  PYTHON_SIMULATOR
}

enum CompactionStatus {
  NOT_REQUIRED
  PENDING
  COMPACTED
  FAILED
}

enum RemoteCommandStatus {
  QUEUED
  DISPATCHED
  SUCCEEDED
  FAILED
  EXPIRED
}

enum RemoteCommandType {
  REFRESH_STATE
  CAPTURE_SNAPSHOT
  SYNC_NOW
  STOP_ALL
  OPEN_GATE
  CLOSE_GATE
  RESET_ALERT
  ENTER_MAINTENANCE
  RESUME_OPERATION
}

enum MachineEventType {
  HEARTBEAT
  QR_REFRESHED
  CHAMBER_OPENED
  CHAMBER_TIMEOUT
  ITEM_DETECTED
  WEIGHT_MEASURED
  IMAGE_CLASSIFIED
  BARCODE_READ
  SENSOR_SEQUENCE
  ITEM_ACCEPTED_POINT
  ITEM_REJECTED
  CONVEYOR_STARTED
  COMPACTION_STARTED
  COMPACTION_COMPLETED
  FRAUD_DETECTED
  VANDALISM_DETECTED
  SAFE_STATE_ENTERED
  STATUS_CHANGED
  FILL_LEVEL_UPDATED
  ERROR
}

enum LedgerEntryType {
  EARN
  REDEEM
  PENALTY
  REVERSE
  ADJUST
}

enum LedgerStatus {
  PENDING
  AVAILABLE
  REDEEMED
  REVERSED
  REJECTED
}

enum PayoutProviderType {
  LINKAJA
  GOPAY
  OVO
  DANA
  SHOPEEPAY
  BANK
  OTHER
}

enum PayoutAccountStatus {
  UNVERIFIED
  VERIFIED
  DISABLED
}

/// Where Redemption.payoutDestination* came from. NULL on a row means a legacy
/// request whose destination has not been captured yet.
enum PayoutDestinationSource {
  /// Copied from the chosen PayoutAccount inside the request transaction.
  REQUEST_SNAPSHOT
  /// Legacy request: copied from the account as it was when an operator first
  /// acted on it (process / success / proof), not at request time.
  LEGACY_ACCOUNT_FALLBACK
  /// Legacy request whose account no longer exists: nothing is guessed.
  LEGACY_UNAVAILABLE
}

enum RedemptionStatus {
  REQUESTED
  APPROVED
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum RedemptionMethod {
  MANUAL_TRANSFER
  PROVIDER_API
}

enum PickupStatus {
  REQUESTED
  ASSIGNED
  ON_THE_WAY
  ARRIVED
  COLLECTED
  COMPLETED
  FAILED
  CANCELLED
}

enum PickupReason {
  FULL
  SCHEDULED
  MANUAL
  ERROR
}

enum PickupItemSource {
  MACHINE_COUNT
  MANUAL_WEIGHING
}

enum TripStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ConditionStatus {
  GOOD
  PARTIAL
  POOR
  NOT_RETURNED
}

enum TravelAgentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TravelAgentOrgStatus {
  PENDING
  INVITED
  SUSPENDED
  REMOVED
}

enum TravelAgentInviteStatus {
  PENDING
  INVITED
}

enum TravelAgentUserRole {
  OWNER
  STAFF
  TOUR_LEADER
}

enum ValidationStage {
  CHECK_IN
  CHECK_OUT
  BANK_SAMPAH_PICKUP
}

enum GateType {
  ENTRY
  EXIT
  BANK_SAMPAH
}

enum ComplianceStatus {
  NOT_STARTED
  CHECKED_IN
  COMPLIANT
  NEEDS_REVIEW
  NON_COMPLIANT
}

enum NotificationType {
  PICKUP_ASSIGNED
  REDEMPTION_STATUS
  MACHINE_FULL
  MACHINE_FRAUD
  TRIP_STATUS
  TRASH_BAG_REWARD
}

// ============================================================
// Core identity & tenancy
// ============================================================

model User {
  id                      String        @id @default(cuid())
  name                    String
  /// AES-GCM ciphertext (random IV). Equality lookups use emailLookup, not this field.
  email                   String
  /// HMAC blind index for login/register (middleware fills on write; cuid default only for create typing).
  emailLookup             String        @unique @default(cuid())
  phone                   String?
  passwordHash            String?
  authProvider            String        @default("CREDENTIALS")
  role                    Role          @default(USER)
  organizationId          String?
  organization            Organization? @relation(fields: [organizationId], references: [id])
  status                  UserStatus    @default(ACTIVE)
  payoutEligible          Boolean       @default(true)
  // Bumped on password reset/change, role demotion, or suspension — stale JWTs are rejected.
  tokenVersion            Int           @default(0)
  mfaEnabled              Boolean       @default(false)
  totpSecret              String?
  /// A02 fix 1: RFC 6238 time step of the last code accepted for the active
  /// factor (login, setup/disable proof, or the confirm code of a new factor).
  /// A code at this step or earlier is a replay and is refused. Null: none yet.
  totpLastUsedStep        Int?
  /// A02: a setup or replacement factor awaiting its first code (AES-GCM
  /// ciphertext, like totpSecret). Never used for login; the active factor
  /// stays in totpSecret until lib/mfa.ts promotes this one under the User
  /// lock. The three pending fields are all set or all null (CHECK
  /// "User_pendingTotp_all_or_none" in migration 20261014023251_mfa_pending_setup).
  pendingTotpSecret       String?
  pendingTotpExpiresAt    DateTime?
  /// tokenVersion when the setup started; any later bump voids the setup.
  pendingTotpTokenVersion Int?
  /// A03: when the current email was proven (an emailed verification or
  /// invitation token was used by this account). Null for every account
  /// before A03 and after each email change, until the new address is proven.
  emailVerifiedAt         DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  depositSessions         DepositSession[]
  ledgerEntries           RewardLedger[]
  rewardCases             RewardReconciliationCase[]
  payoutAccounts          PayoutAccount[]
  redemptions             Redemption[]
  collectorPartnerships   OrganizationCollectorPartner[] @relation("CollectorPartnerships")
  assignedPickups         PickupRequest[]                @relation("AssignedCollector")
  travelAgentLinks        TravelAgentUser[]
  trips                   Trip[]
  notifications           Notification[]
  deviceTokens            DeviceToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  emailOutbox             EmailOutbox[]

  @@index([organizationId])
  @@index([role])
}

model Organization {
  id                String             @id @default(cuid())
  name              String
  type              OrgType            @default(OTHER)
  // Region levels stored as soft references (Region.id) for aggregation/reporting.
  provinceId        String?
  regencyId         String?
  districtId        String?
  villageId         String?
  regionId          String?
  region            Region?            @relation(fields: [regionId], references: [id])
  address           String?
  contactName       String?
  contactPhone      String?
  status            OrgStatus          @default(ACTIVE)
  /// Reward mode of machine deposits made without a campaign (M04). Explicit
  /// per organization; MONEY_REWARD keeps the behaviour before M04.
  machineRewardMode CampaignRewardMode @default(MONEY_REWARD)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  users              User[]
  machines           Machine[]
  campaigns          Campaign[]
  rewardRates        RewardRate[]
  collectorPartners  OrganizationCollectorPartner[]
  pickupRequests     PickupRequest[]
  ledgerEntries      RewardLedger[]
  travelAgentLinks   TravelAgentOrganization[]
  travelAgentInvites TravelAgentInvite[]
  rewardFunding      RewardFundingAccount?

  @@index([regionId])
  @@index([type])
}

model Region {
  id        String     @id @default(cuid())
  type      RegionType
  name      String
  parentId  String?
  parent    Region?    @relation("RegionTree", fields: [parentId], references: [id])
  children  Region[]   @relation("RegionTree")
  createdAt DateTime   @default(now())

  organizations Organization[]
  machines      Machine[]

  @@index([parentId])
  @@index([type])
}

model OrganizationCollectorPartner {
  id                     String        @id @default(cuid())
  organizationId         String
  organization           Organization  @relation(fields: [organizationId], references: [id])
  collectorUserId        String
  collectorUser          User          @relation("CollectorPartnerships", fields: [collectorUserId], references: [id])
  status                 PartnerStatus @default(PENDING_SUPERADMIN_APPROVAL)
  serviceAreaJson        Json?
  contactName            String?
  contactPhone           String?
  notes                  String?
  createdByAdminId       String?
  approvedBySuperadminId String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  pickupRequests PickupRequest[]

  @@unique([organizationId, collectorUserId])
  @@index([collectorUserId, status])
  @@index([organizationId, status])
}

// ============================================================
// Machines, waste types, rates
// ============================================================

model Machine {
  id                        String               @id @default(cuid())
  organizationId            String
  organization              Organization         @relation(fields: [organizationId], references: [id])
  regionId                  String?
  region                    Region?              @relation(fields: [regionId], references: [id])
  machineCode               String               @unique
  qrToken                   String?
  qrTokenExpiresAt          DateTime?
  qrRotationSeconds         Int                  @default(30)
  // Per-machine secret for HMAC-signed event ingestion (provisioned by superadmin).
  ingestSecret              String?
  name                      String
  description               String?
  status                    MachineStatus        @default(OFFLINE)
  fillLevelPercent          Int                  @default(0)
  capacityKg                Float?
  hasInputChamber           Boolean              @default(true)
  hasConveyor               Boolean              @default(true)
  hasCompactor              Boolean              @default(false)
  hasExternalCamera         Boolean              @default(false)
  /// Material verification policy (M04); WEIGHT_ONLY keeps the behaviour before M04.
  materialVerification      MaterialVerification @default(WEIGHT_ONLY)
  chamberTimeoutSeconds     Int                  @default(20)
  sessionIdleTimeoutMinutes Int                  @default(3)
  /// B01: reward ceiling reserved for one deposit session on this machine
  /// (integer rupiah) when the session's campaign sets none. Null = not
  /// configured: with REWARD_FUNDING_ENFORCED a money session is refused.
  maxRewardPerSessionRupiah Int?
  /// B01: item bound of one session, bound into the signed lease by B01b.
  maxItemsPerSession        Int?
  lastHeartbeatAt           DateTime?
  latitude                  Float?
  longitude                 Float?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  wasteTypes     MachineWasteType[]
  sessions       DepositSession[]
  events         MachineEvent[]
  captures       MachineCapture[]
  media          MachineMedia[]
  remoteCommands MachineRemoteCommand[]
  pickupRequests PickupRequest[]

  @@index([organizationId])
  @@index([status])
}

model WasteType {
  id                   String    @id @default(cuid())
  name                 String
  unit                 WasteUnit @default(ITEM)
  minWeightGrams       Int?
  maxWeightGrams       Int?
  defaultRewardPerItem Int?
  description          String?
  active               Boolean   @default(true)
  /// Classifier labels (normalized, e.g. `bottle_pet`) that confirm this waste
  /// type (M04). Empty = the type cannot be verified by AI.
  aiAcceptedLabels     String[]  @default([])
  // null = global (managed by superadmin); set = organization-specific (admin-added)
  organizationId       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  machineLinks MachineWasteType[]
  rewardRates  RewardRate[]
  depositItems DepositItem[]
  pickupItems  PickupItem[]
  trashBags    TrashBagAssignment[]

  @@index([organizationId])
}

model MachineWasteType {
  id          String    @id @default(cuid())
  machineId   String
  machine     Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  wasteTypeId String
  wasteType   WasteType @relation(fields: [wasteTypeId], references: [id])
  active      Boolean   @default(true)

  @@unique([machineId, wasteTypeId])
  @@index([wasteTypeId])
}

model RewardRate {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  campaignId     String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id])
  wasteTypeId    String
  wasteType      WasteType     @relation(fields: [wasteTypeId], references: [id])
  unit           WasteUnit     @default(ITEM)
  pointsPerItem  Int
  minWeightGrams Int?
  maxWeightGrams Int?
  effectiveFrom  DateTime      @default(now())
  effectiveTo    DateTime?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())

  depositItems DepositItem[]

  @@index([wasteTypeId, active])
  @@index([organizationId])
  @@index([campaignId])
}

// ============================================================
// Campaigns
// ============================================================

model Campaign {
  id                      String             @id @default(cuid())
  organizationId          String
  organization            Organization       @relation(fields: [organizationId], references: [id])
  name                    String
  description             String?
  campaignType            CampaignType       @default(MACHINE_DEPOSIT)
  rewardMode              CampaignRewardMode @default(MONEY_REWARD)
  /// EVENT / SCHOOL_PROGRAM only: the program may run at machines (M04).
  /// MACHINE_DEPOSIT always may; TRASH_BAG / TOURISM_PROGRAM never do.
  supportsMachine         Boolean            @default(false)
  visibility              CampaignVisibility @default(PUBLIC)
  allowedEmailDomainsJson Json?
  startAt                 DateTime?
  endAt                   DateTime?
  status                  CampaignStatus     @default(DRAFT)
  rewardMultiplier        Float?
  rulesJson               Json?
  /// B01: total reward budget of the program (integer rupiah); null = no
  /// program cap (the organization's funded capacity still applies).
  rewardBudgetRupiah        Int?
  /// B01: admission ceilings reserved and not yet committed (lib/reward-funding.ts).
  heldRupiah                Int                @default(0)
  /// B01: committed reward obligations (earned, pending review or paid); not refilled by a payout.
  spentRupiah               Int                @default(0)
  /// B01: reward ceiling reserved per deposit session under this program; falls back to Machine.maxRewardPerSessionRupiah.
  maxRewardPerSessionRupiah Int?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  sessions      DepositSession[]
  rewardRates   RewardRate[]
  ledgerEntries RewardLedger[]
  trips         Trip[]
  rewardReservations RewardBudgetReservation[]
  rewardCommits      RewardBudgetCommit[]

  @@index([organizationId, status])
}

// ============================================================
// Deposit flow
// ============================================================

// One active session per machine (R03, EX-04): the hand-written partial unique
// index "DepositSession_one_active_per_machine" on ("machineId") WHERE status IN
// (RESERVED, ACTIVE, PROCESSING_ITEM, REVIEW). Staged in
// prisma/migrations-enforce/one_active_machine_session_enforce and moved into
// prisma/migrations in a later release, after `npm run reconcile:sessions`
// exits 0. Prisma 6 cannot express partial indexes; remove any generated DROP
// INDEX for it. Writers go through lib/deposit-session-service.ts (User ->
// Machine row locks), which keep exclusivity without the index.
model DepositSession {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  machineId    String
  machine      Machine       @relation(fields: [machineId], references: [id])
  campaignId   String?
  campaign     Campaign?     @relation(fields: [campaignId], references: [id])
  status       SessionStatus @default(RESERVED)
  startedAt    DateTime      @default(now())
  completedAt  DateTime?
  timeoutAt    DateTime?
  anomalyCount Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items         DepositItem[]
  events        MachineEvent[]
  captures      MachineCapture[]
  ledgerEntries RewardLedger[]

  @@index([userId])
  @@index([machineId, status])
}

model DepositItem {
  id                   String            @id @default(cuid())
  sessionId            String
  session              DepositSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  wasteTypeId          String
  wasteType            WasteType         @relation(fields: [wasteTypeId], references: [id])
  quantity             Int               @default(1)
  measuredWeightGrams  Int?
  aiDetectedType       String?
  aiConfidence         Float?
  barcodeValue         String?
  rewardRateId         String?
  rewardRate           RewardRate?       @relation(fields: [rewardRateId], references: [id])
  baseRewardAmount     Int               @default(0)
  complianceMultiplier Float             @default(1.0)
  rewardAmount         Int               @default(0)
  status               DepositItemStatus @default(PENDING)
  source               ItemSource        @default(PYTHON_SIMULATOR)
  validationReasonCode String?
  sensorSequenceJson   Json?
  acceptedAt           DateTime?
  acceptanceEventId    String?
  externalFraudFlag    Boolean           @default(false)
  compactionStatus     CompactionStatus  @default(NOT_REQUIRED)
  evidenceUrl          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  events        MachineEvent[]
  ledgerEntries RewardLedger[]

  @@index([sessionId])
  @@index([status])
}

enum MachineMediaType {
  IMAGE
  VIDEO
}

model MachineCapture {
  id             String          @id @default(cuid())
  machineId      String
  machine        Machine         @relation(fields: [machineId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        DepositSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  localCaptureId String
  kind           String
  reason         String
  scenePath      String
  facePathsJson  Json
  metadataJson   Json?
  faceCount      Int             @default(0)
  personDetected Boolean         @default(false)
  occurredAt     DateTime
  receivedAt     DateTime        @default(now())

  @@unique([machineId, localCaptureId])
  @@index([machineId, occurredAt])
  @@index([sessionId])
  @@index([kind, occurredAt])
}

model MachineMedia {
  id              String           @id @default(cuid())
  machineId       String
  machine         Machine          @relation(fields: [machineId], references: [id], onDelete: Cascade)
  title           String?
  mediaType       MachineMediaType
  mimeType        String
  originalName    String
  storagePath     String
  fileSize        Int
  sha256          String
  durationSeconds Int              @default(8)
  sortOrder       Int              @default(0)
  active          Boolean          @default(true)
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([machineId, active, sortOrder])
}

model MachineRemoteCommand {
  id            String              @id @default(cuid())
  machineId     String
  machine       Machine             @relation(fields: [machineId], references: [id], onDelete: Cascade)
  requestedById String?
  command       RemoteCommandType
  status        RemoteCommandStatus @default(QUEUED)
  payloadJson   Json?
  resultJson    Json?
  errorMessage  String?
  expiresAt     DateTime
  dispatchedAt  DateTime?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([machineId, status, createdAt])
  @@index([requestedById, createdAt])
}

model MachineEvent {
  id            String           @id @default(cuid())
  machineId     String
  machine       Machine          @relation(fields: [machineId], references: [id])
  sessionId     String?
  session       DepositSession?  @relation(fields: [sessionId], references: [id])
  depositItemId String?
  depositItem   DepositItem?     @relation(fields: [depositItemId], references: [id])
  localEventId  String
  eventType     MachineEventType
  payloadJson   Json?
  occurredAt    DateTime         @default(now())
  receivedAt    DateTime         @default(now())

  // Idempotency: a machine retrying the same local event must not double-process.
  @@unique([machineId, localEventId])
  @@index([machineId, occurredAt])
  @@index([sessionId])
}

// ============================================================
// Reward ledger (append-only)
// ============================================================

model RewardLedger {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  sessionId      String?
  session        DepositSession? @relation(fields: [sessionId], references: [id])
  depositItemId  String?
  depositItem    DepositItem?    @relation(fields: [depositItemId], references: [id])
  campaignId     String?
  campaign       Campaign?       @relation(fields: [campaignId], references: [id])
  entryType      LedgerEntryType
  amount         Int // signed rupiah: credits positive, debits negative
  status         LedgerStatus    @default(PENDING)
  reasonCode     String?
  referenceType  String?
  referenceId    String?
  actorId        String?
  /// Unique key of the financial effect this row records (e.g. `redemption:<id>:reserve`,
  /// `deposit-item:<id>:earn`, `trip:<id>:return`). Required for every new write; null only on legacy rows.
  businessKey    String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Partial unique indexes Prisma 6 cannot express (migrations 20261013122400_wallet_keys_enforce,
  // 20261013151919_trip_reward_keys_enforce); remove any DROP INDEX for them that
  // `prisma migrate diff/dev` generates:
  //   RewardLedger_one_earn_per_deposit_item   ("depositItemId") WHERE EARN AND status <> 'REVERSED'
  //   RewardLedger_one_reserve_per_redemption  ("referenceId") WHERE REDEEM/Redemption AND status <> 'REJECTED'
  //   RewardLedger_one_earn_per_trip           ("referenceId") WHERE EARN/TRASH_BAG_RETURN/Trip AND status <> 'REVERSED'
  @@index([userId, status])
  @@index([sessionId])
  @@index([depositItemId])
  @@index([referenceType, referenceId])
}

/// A money effect the system refused to apply automatically (M04,
/// lib/reward-credit.ts): a correction that would push a balance that was
/// already paid out or reserved below zero, or a credit to an account the A04
/// erasure anonymized. The ledger is never forced; an operator resolves the
/// case outside the automatic flow. Listed in the reconciliation report.
model RewardReconciliationCase {
  id            String                     @id @default(cuid())
  /// Business key of the refused effect (e.g. `review:<itemId>:decision:v1`, `fraud:<itemId>:hold:v1`).
  businessKey   String                     @unique
  userId        String
  user          User                       @relation(fields: [userId], references: [id])
  depositItemId String?
  /// Positive rupiah at stake; reasonCode says whether a debit or a credit was refused.
  amount        Int
  /// Ledger entry type of the effect that was not written.
  entryType     LedgerEntryType
  /// ANOMALY_ALREADY_PAID_OUT | RECIPIENT_ERASED
  reasonCode    String
  referenceType String?
  referenceId   String?
  status        RewardReconciliationStatus @default(OPEN)
  note          String?
  resolvedAt    DateTime?
  resolvedById  String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

/// B01 (BIZ-02): confirmed reward cash and held reward obligations of one
/// organization. Counters are maintained only under the row lock
/// (lib/db-locks.ts lockFundingAccount) by lib/reward-funding.ts; every change
/// is backed by an immutable FundingEntry (cash) or a reservation/commit row
/// (obligation). `confirmedRupiah - heldRupiah` is the capacity an admission
/// may still reserve.
model RewardFundingAccount {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id])
  /// Cash confirmed by an operator with evidence (sum of entries).
  confirmedRupiah Int          @default(0)
  /// Reward obligations not yet paid: admission ceilings still reserved plus committed earnings.
  heldRupiah      Int          @default(0)
  /// Bumped on every counter change (diagnostics; the row lock serializes writers).
  version         Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  entries      FundingEntry[]
  reservations RewardBudgetReservation[]
  commits      RewardBudgetCommit[]
}

/// Immutable cash movement of a funding account. Never moves real money:
/// CONFIRMED_TOPUP records a verified deposit (unique `reference`), PAYOUT the
/// gross of a successful user payout attributed to this source, CORRECTION a
/// signed operator correction with evidence.
model FundingEntry {
  id           String               @id @default(cuid())
  accountId    String
  account      RewardFundingAccount @relation(fields: [accountId], references: [id])
  /// `topup:<organizationId>:<reference>`, `correction:<organizationId>:<reference>`, `redemption:<id>:payout:<accountId>`.
  businessKey  String               @unique
  kind         FundingEntryKind
  /// Signed integer rupiah: topups positive, payouts negative, corrections either sign.
  amount       Int
  /// Operator evidence reference (bank/transfer reference) or the redemption id for a payout.
  reference    String
  note         String?
  verifiedById String?
  createdAt    DateTime             @default(now())

  @@index([accountId, createdAt])
  @@index([kind, reference])
}

/// Reward capacity reserved before material is admitted: a deposit session's
/// ceiling (`session:<id>:admission`) or a trip's issued bags
/// (`trip:<id>:issuance`). `remainingRupiah` is what commits may still draw;
/// a session's residue is released only by an explicit operator action (B01a)
/// or the RVM close watermark (B01b), never by a timeout.
model RewardBudgetReservation {
  id                      String                  @id @default(cuid())
  businessKey             String                  @unique
  accountId               String
  account                 RewardFundingAccount    @relation(fields: [accountId], references: [id])
  campaignId              String?
  campaign                Campaign?               @relation(fields: [campaignId], references: [id])
  userId                  String
  sourceType              RewardReservationSource
  sourceId                String
  ceilingRupiah           Int
  remainingRupiah         Int
  /// Shadow mode only: capacity the account lacked when this was reserved (0 when covered).
  shortfallRupiah         Int                     @default(0)
  /// Shadow mode only: budget the campaign lacked when this was reserved (0 when covered).
  campaignShortfallRupiah Int                     @default(0)
  status                  RewardReservationStatus @default(ACTIVE)
  releasedAt              DateTime?
  releasedById            String?
  releaseReason           String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  commits RewardBudgetCommit[]

  @@index([accountId, status])
  @@index([sourceType, sourceId])
  @@index([userId])
}

/// One reward obligation drawn from a reservation, keyed by the earning's
/// business key (`deposit-item:<id>:earn`, `trip:<id>:return`) so a retried
/// event never consumes budget twice. `heldRupiah` is the obligation (the
/// approvable ceiling while `reviewPending`), `paidRupiah` the part already
/// attributed to successful payouts, `uncoveredRupiah` the part that exceeded
/// the reservation when committed (material already accepted never loses its
/// reward; the excess is reported).
model RewardBudgetCommit {
  id              String                  @id @default(cuid())
  reservationId   String
  reservation     RewardBudgetReservation @relation(fields: [reservationId], references: [id])
  accountId       String
  account         RewardFundingAccount    @relation(fields: [accountId], references: [id])
  campaignId      String?
  campaign        Campaign?               @relation(fields: [campaignId], references: [id])
  userId          String
  businessKey     String                  @unique
  heldRupiah      Int
  paidRupiah      Int                     @default(0)
  uncoveredRupiah Int                     @default(0)
  reviewPending   Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([reservationId])
  @@index([accountId])
  @@index([userId, reviewPending])
}

// ============================================================
// Payout & redemption
// ============================================================

model PayoutAccount {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  provider          PayoutProviderType
  accountIdentifier String
  accountName       String?
  verifiedAt        DateTime?
  status            PayoutAccountStatus @default(UNVERIFIED)
  kycRequired       Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId])
}

model Redemption {
  id                          String                   @id @default(cuid())
  userId                      String
  user                        User                     @relation(fields: [userId], references: [id])
  provider                    PayoutProviderType       @default(OTHER)
  payoutAccountId             String?
  amount                      Int
  method                      RedemptionMethod         @default(MANUAL_TRANSFER)
  status                      RedemptionStatus         @default(REQUESTED)
  providerReference           String?
  manualTransferProofUrl      String?
  note                        String?
  processedBySuperadminId     String?
  /// Client key for one logical request, unique per user (not globally).
  idempotencyKey              String
  /// sha256 of the canonical request (amount + payoutAccountId); null on legacy rows.
  requestHash                 String?
  /// Immutable payout destination used by the queue, process, success and proof
  /// (never the mutable PayoutAccount). Identifier/name are AES-GCM ciphertext
  /// from lib/encryption; never return them to clients (lib/payout-destination.ts).
  payoutDestinationSource     PayoutDestinationSource?
  payoutDestinationProvider   PayoutProviderType?
  payoutDestinationIdentifier String?
  payoutDestinationName       String?
  payoutDestinationCapturedAt DateTime?
  /// Operator could not confirm the external transfer: the request stays
  /// PROCESSING with its reserve held until the outcome is reconciled.
  reconciliationRequired      Boolean                  @default(false)
  reconciliationNote          String?
  reconciliationFlaggedAt     DateTime?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([status])
}

// ============================================================
// Pickup workflow
// ============================================================

model PickupRequest {
  id                  String                        @id @default(cuid())
  machineId           String?
  machine             Machine?                      @relation(fields: [machineId], references: [id])
  organizationId      String
  organization        Organization                  @relation(fields: [organizationId], references: [id])
  requestedById       String?
  assignedCollectorId String?
  assignedCollector   User?                         @relation("AssignedCollector", fields: [assignedCollectorId], references: [id])
  collectorPartnerId  String?
  collectorPartner    OrganizationCollectorPartner? @relation(fields: [collectorPartnerId], references: [id])
  status              PickupStatus                  @default(REQUESTED)
  priority            Int                           @default(0)
  reason              PickupReason                  @default(FULL)
  notes               String?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  items PickupItem[]

  @@index([organizationId, status])
  @@index([assignedCollectorId])
}

model PickupItem {
  id                String           @id @default(cuid())
  pickupRequestId   String
  pickupRequest     PickupRequest    @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  wasteTypeId       String?
  wasteType         WasteType?       @relation(fields: [wasteTypeId], references: [id])
  estimatedWeightKg Float?
  actualWeightKg    Float?
  itemCount         Int?
  source            PickupItemSource @default(MANUAL_WEIGHING)
  notes             String?
  createdAt         DateTime         @default(now())

  @@index([pickupRequestId])
}

// ============================================================
// Optional Trip / Trash bag mode
// ============================================================

model TravelAgent {
  id            String            @id @default(cuid())
  name          String
  email         String            @unique
  phone         String?
  contactPerson String?
  status        TravelAgentStatus @default(ACTIVE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  organizations TravelAgentOrganization[]
  users         TravelAgentUser[]
  invites       TravelAgentInvite[]
  trips         Trip[]

  @@index([status])
}

model TravelAgentOrganization {
  id             String               @id @default(cuid())
  travelAgentId  String
  travelAgent    TravelAgent          @relation(fields: [travelAgentId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         TravelAgentOrgStatus @default(PENDING)
  invitedById    String?
  approvedAt     DateTime?
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([travelAgentId, organizationId])
  @@index([organizationId, status])
  @@index([travelAgentId, status])
}

model TravelAgentInvite {
  id             String                  @id @default(cuid())
  travelAgentId  String?
  travelAgent    TravelAgent?            @relation(fields: [travelAgentId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  status         TravelAgentInviteStatus @default(PENDING)
  invitedById    String?
  /// A03: SHA-256 of the single-use token in the emailed link (lib/invitations.ts).
  /// The raw token is never stored: it is minted when the mail is sent
  /// (lib/email-outbox.ts), so each delivery replaces the previous token.
  /// Null until the first delivery.
  tokenHash      String?                 @unique
  /// 24 hours after the latest delivery; null until the first delivery.
  expiresAt      DateTime?
  /// Set once, by the accepting account (compare-and-set in acceptTravelAgentInvite).
  acceptedAt     DateTime?
  acceptedById   String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  outbox EmailOutbox[]

  @@index([email, status])
  @@index([organizationId, status])
  @@index([acceptedById])
}

model TravelAgentUser {
  id            String              @id @default(cuid())
  travelAgentId String
  travelAgent   TravelAgent         @relation(fields: [travelAgentId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInAgent   TravelAgentUserRole @default(OWNER)
  /// A03: set when this account accepted an emailed invitation for the agent.
  /// Trip access needs it (and a verified account email); null for every
  /// membership created before A03 and after the account's email changes.
  verifiedAt    DateTime?
  createdAt     DateTime            @default(now())

  @@unique([travelAgentId, userId])
  @@index([userId])
}

model Trip {
  id               String           @id @default(cuid())
  campaignId       String
  campaign         Campaign         @relation(fields: [campaignId], references: [id])
  userId           String?
  user             User?            @relation(fields: [userId], references: [id])
  travelAgentId    String?
  travelAgent      TravelAgent?     @relation(fields: [travelAgentId], references: [id])
  travelAgentName  String?
  groupName        String?
  leaderName       String?
  leaderContact    String?
  participantCount Int              @default(1)
  status           TripStatus       @default(PLANNED)
  complianceStatus ComplianceStatus @default(NOT_STARTED)
  complianceScore  Int              @default(0)
  checkInAt        DateTime?
  checkOutAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  bagAssignments TrashBagAssignment[]
  validations    ManualValidation[]

  @@index([campaignId])
  @@index([travelAgentId])
  @@index([userId])
  @@index([complianceStatus])
}

model TrashBagAssignment {
  id           String           @id @default(cuid())
  tripId       String
  trip         Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  assignedById String?
  wasteTypeId  String?
  wasteType    WasteType?       @relation(fields: [wasteTypeId], references: [id])
  bagQrCode    String           @unique
  bagCount     Int              @default(1)
  status       ConditionStatus?
  returnedAt   DateTime?
  assignedAt   DateTime         @default(now())

  @@index([tripId])
  @@index([wasteTypeId])
}

model ManualValidation {
  id               String            @id @default(cuid())
  tripId           String?
  trip             Trip?             @relation(fields: [tripId], references: [id])
  validatedById    String?
  validationStage  ValidationStage   @default(CHECK_OUT)
  gateType         GateType?
  bagQrCode        String?
  returnedBagCount Int?
  actualWeightKg   Float?
  conditionStatus  ConditionStatus?
  appCompleted     Boolean           @default(false)
  complianceScore  Int?
  complianceStatus ComplianceStatus?
  notes            String?
  evidenceUrl      String?
  createdAt        DateTime          @default(now())

  @@index([tripId])
  @@index([validationStage])
  @@index([complianceStatus])
}

// ============================================================
// Audit & config
// ============================================================

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  entityType   String
  entityId     String?
  metadataJson Json?
  // Tamper-evident chain: SHA-256 of (previousHash + canonical payload)
  previousHash String?
  checksum     String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([previousHash])
}

model ConsentRecord {
  id          String   @id @default(cuid())
  userId      String
  consentType String
  granted     Boolean
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId, consentType])
  @@index([createdAt])
}

model DeletionRequest {
  id          String                @id @default(cuid())
  /// Email typed into the public form (null for requests made from a signed-in
  /// session). Erased together with the account (lib/erasure-jobs.ts).
  email       String?
  userId      String?
  // PARTIAL = some data categories; FULL = account erasure (lib/erasure-jobs.ts)
  scope       DeletionRequestScope  @default(PARTIAL)
  dataTypes   String[] // For PARTIAL: which categories were requested
  reason      String?
  status      DeletionRequestStatus @default(PENDING)
  ipAddress   String?
  userAgent   String?
  processedAt DateTime?
  createdAt   DateTime              @default(now())

  /// How the account owner confirmed a FULL request; null = not verified, never executed.
  verificationMethod    DeletionVerificationMethod?
  /// SHA-256 of the one-time token mailed to the account (raw token never stored).
  verificationTokenHash String?                     @unique
  verificationExpiresAt DateTime?
  verifiedAt            DateTime?
  /// PENDING_RECONCILIATION only: the open balances/obligations that hold the
  /// erasure (numbers and counts, never personal data).
  reconciliationJson    Json?

  steps ErasureJobStep[]

  @@index([email])
  @@index([status, createdAt])
  @@index([userId, status])
}

enum DeletionRequestScope {
  PARTIAL
  FULL
}

/// PENDING: received, not verified by the account owner (nothing runs).
/// VERIFIED/PROCESSING: verified, erasure steps queued or running.
/// PENDING_RECONCILIATION: verified, held until open balances/payouts settle; nothing erased yet.
/// RETRYABLE_FAILED: a required step failed and will be retried; not complete.
/// COMPLETED: every required step finished.
enum DeletionRequestStatus {
  PENDING
  VERIFIED
  PROCESSING
  PENDING_RECONCILIATION
  RETRYABLE_FAILED
  COMPLETED
  REJECTED
}

enum DeletionVerificationMethod {
  /// The owner asked from an authenticated session (DELETE /api/user/data).
  SESSION
  /// The owner opened the one-time link mailed to the account address.
  EMAIL_TOKEN
  /// An operator verified the owner out of band (scripts/process-erasure-jobs.ts).
  OPERATOR
}

enum ErasureStepName {
  /// One DB transaction under the User lock: redact profile, clear secrets and
  /// tokens, disable payout accounts, erase destination copies and free text.
  ANONYMIZE_ACCOUNT
  /// After commit: delete the owner's transfer-proof files from private storage.
  DELETE_PROOF_FILES
}

/// Durable, idempotent step of a FULL deletion request. A request is COMPLETED
/// only when every one of its steps has completedAt.
model ErasureJobStep {
  id            String          @id @default(cuid())
  requestId     String
  request       DeletionRequest @relation(fields: [requestId], references: [id])
  step          ErasureStepName
  attempts      Int             @default(0)
  /// Earliest time the periodic runner retries/re-checks this step.
  nextAttemptAt DateTime        @default(now())
  completedAt   DateTime?
  /// Error class/code of the last failed attempt (never a message with data).
  lastError     String?
  /// Non-personal inputs of a post-commit step (e.g. redemption ids whose proof folders are removed).
  payloadJson   Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([requestId, step])
  @@index([completedAt, nextAttemptAt])
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================
// Notifications
// ============================================================

// In-app notification feed (pickup assignment, redemption status changes,
// machine FULL/fraud alerts). Delivered in-app always; also pushed via FCM
// when the recipient has a registered device token and firebase-admin is
// configured (see lib/notifications.ts) — push delivery is best-effort and
// never blocks writing the in-app row.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  dataJson  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

// Registered by the mobile app (see mobile/lib/services/notification_service.dart)
// so push notifications have somewhere to be sent; a user can have multiple
// tokens (multiple devices). Deleting a token is a plain unregister, not a
// user action, so this table has no direct UI of its own.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the raw token that is delivered to the user; the raw value is
  // never stored so a DB leak cannot be used to reset accounts.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A03: purpose of an EmailVerificationToken (the hash is separated per purpose).
enum EmailTokenPurpose {
  VERIFY_EMAIL
}

/// A03: single-use proof that the account holder reads `emailLookup`'s mailbox.
/// Only the SHA-256 of the raw token is stored. The token is valid only while
/// the account's current emailLookup still equals the snapshot.
model EmailVerificationToken {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     EmailTokenPurpose @default(VERIFY_EMAIL)
  /// HMAC blind index of the address the link was sent to (User.emailLookup at send time).
  emailLookup String
  tokenHash   String            @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum EmailOutboxKind {
  TRAVEL_AGENT_INVITE
  EMAIL_VERIFICATION
}

enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  CANCELLED
  FAILED
}

/// A03: durable delivery of invitation and verification mail
/// (lib/email-outbox.ts, scripts/process-email-outbox.ts). A row holds no
/// address and no token: the recipient is read from the invite or user when
/// the mail is sent, and the token is minted at that moment and only its hash
/// is written (to the invite or an EmailVerificationToken).
model EmailOutbox {
  id            String             @id @default(cuid())
  kind          EmailOutboxKind
  inviteId      String?
  invite        TravelAgentInvite? @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// EMAIL_VERIFICATION: User.emailLookup when queued; a later email change cancels the row.
  emailLookup   String?
  status        EmailOutboxStatus  @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  /// SENDING rows whose lease passed are retried (a crashed sender).
  leaseUntil    DateTime?
  /// Error class or code only (never a message, address or link).
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, nextAttemptAt])
  @@index([inviteId])
  @@index([userId])
}
