# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://reloop:reloop@localhost:5432/reloop?schema=public"

# Secret used to sign auth session JWTs (use a long random string in production)
AUTH_JWT_SECRET="change-me-to-a-long-random-string"

# DEPRECATED as a global gate. Machine event ingestion now uses a PER-MACHINE
# secret + HMAC-signed requests (see Machine.ingestSecret, provisioned by superadmin).
# The Python simulator reads this only as a convenience default for --secret.
MACHINE_INGEST_SECRET=""

# Public app name shown in the UI
NEXT_PUBLIC_APP_NAME="ReLoop"

# Public URL of the web app, exactly as browsers reach it (behind nginx this is
# the public https://host, never the container's 0.0.0.0:3000). Used by the
# simulator and QR display payloads, and it is the only trusted origin for:
#  - emailed links (password reset, account-deletion confirmation, invitations,
#    email verification);
#  - signed-in browser writes: the request proxy accepts POST/PUT/PATCH/DELETE
#    carrying an Origin header only when that Origin equals this URL's
#    scheme://host[:port] (CSRF check). Requests without Origin (mobile app)
#    are unaffected.
# The request Host / X-Forwarded-Host headers are never trusted. Required in
# production: without a valid http(s) value the email endpoints answer 503 and
# send nothing, and every browser write is refused with 403 (logged as
# "NEXT_PUBLIC_BASE_URL is not configured or invalid"). In development an unset
# value falls back to http://localhost:3000, and the dev server's own
# localhost/127.0.0.1 origins on its port are accepted too.
# Set it in the runtime environment (.env / docker compose), not only at
# `next build`: a NEXT_PUBLIC_ value present during the build is inlined into
# the bundle and then wins over the runtime value.
# For the full docker-compose.yml stack browsed through its nginx locally, use
# NEXT_PUBLIC_BASE_URL="http://localhost:8111".
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Lightweight WebSocket notification gateway. Persisted data still travels
# through the authenticated HTTP machine event API.
REALTIME_INTERNAL_SECRET="change-me-realtime-internal-secret"
REALTIME_PUBLISH_URL="http://127.0.0.1:3001/publish"
NEXT_PUBLIC_REALTIME_WS_URL="ws://localhost:3001/ws"
REALTIME_PORT="3001"

# AES-256-GCM key used for PII encryption at rest (User.name, .email, .phone,
# MachineCapture.facePathsJson). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="change-me-to-a-64-char-hex-string"

# Redis (optional — rate limiting & machine nonce replay protection).
# Omit for local dev (falls back to in-memory). Required in production.
REDIS_URL="redis://localhost:6380"

# HMAC secret for tamper-evident audit log chain.
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_CHECKSUM_SECRET="audit-secret-change-me"

# M04 legacy-approval cutover (optional, ISO-8601, e.g. 2026-10-14T01:30:00Z).
# A superadmin may approve a review item that lacks a machine acceptance record
# ("setoran lama") only when the item was created before this instant. Leave
# unset to use the applied time of migration 20261014013000_reward_policy from
# _prisma_migrations (the normal case). Set it only when that time is not the
# real cutover, e.g. a database restored from a snapshot. An unparsable value
# disables legacy approvals entirely (fail closed); it never falls back.
# REWARD_LEGACY_CUTOVER_AT=""

# B01 reward funding enforcement (server-side only, never NEXT_PUBLIC_).
# Only the exact value "true" refuses deposit admissions and bag issuance
# whose reward ceiling is not covered by the organization's confirmed funding
# (and the campaign's budget). Unset/empty/"false" = shadow mode: every
# reservation, commit, release and payout entry is still recorded and the
# shortfalls are reported, but nothing is refused. Any other value is
# malformed and fails closed to shadow mode with a warning. Switch it on only
# after B02 backfilled the opening obligations and operators confirmed real
# funding with evidence (docs/database-ledger-guide.md section 7).
# REWARD_FUNDING_ENFORCED="false"

# B01 funding cutover (optional, ISO-8601). A session or trip created before
# this instant that has no funding reservation is a legacy obligation (B02
# backfills it); a later one without a reservation (its program turned to
# money after admission) is held at its first earning instead. Leave unset to
# use the applied time of migration 20261014150000_reward_funding from
# _prisma_migrations. An unparsable value fails closed: every such source is
# held. Set it only for a database restored from a snapshot.
# REWARD_FUNDING_CUTOVER_AT=""
