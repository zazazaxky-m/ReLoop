        "depositItemId": null,
        "occurredAt": "2026-10-13T08:00:03Z"
      }
    ]
  },
  "response": {
    "protocolVersion": 2,
    "received": 4,
    "results": [
      {
        "localEventId": "3b0f6f4e-2a51-4d7c-9a51-000000000001",
        "status": "accepted",
        "eventId": "cmauditevent00000000000001"
      },
      {
        "localEventId": "3b0f6f4e-2a51-4d7c-9a51-000000000002",
